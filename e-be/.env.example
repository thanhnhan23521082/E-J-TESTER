# ──────────────────────────────────────────────
# ETEST ONE Backend – Environment Variables Template
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Local PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/etest_one

# ── Security ──────────────────────────────────
# Generate with: openssl rand -hex 64
SECRET_KEY=your-super-secret-key-here-change-in-production

# JWT Access token – short-lived (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT Refresh token – long-lived (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI API ─────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-5.4-mini

# ── Search API ─────────────────────────────────
SERPAPI_API_KEY=your-serpapi-key-here

# ── AWS (optional – for future S3/RDS features) ─
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ── Application ────────────────────────────────
# "development" | "staging" | "production"
APP_ENV=development
DEBUG=true

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS – comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── ETESTER Badge Signing ───────────────────────────────
# RS256 private key for badge JWT signing (optional).
# If not set, falls back to HS256 (using SECRET_KEY).
# Generate with: openssl genrsa -out etester_private.pem 2048
# Then: cat etester_private.pem | base64 -w0
ETESTER_RS256_PRIVATE_KEY=
